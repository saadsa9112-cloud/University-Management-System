@model IEnumerable<NedAcademy.Models.CourseModel>
@{
  ViewData["Title"]      = "Courses";
  ViewData["Breadcrumb"] = "Courses";
}

<div class="page-header">
  <div>
    <h1 class="page-title"><i class="fas fa-book-open me-2" style="color:var(--accent)"></i>Courses</h1>
    <p class="page-subtitle">Manage all offered courses and programs</p>
  </div>
  <a asp-action="Create" class="btn btn-primary"><i class="fas fa-plus"></i> Add Course</a>
</div>

<div class="card">
  <div class="card-head">
    <div class="card-head-title">All Courses</div>
    <div class="card-head-sub">@Model.Count() courses available</div>
  </div>
  @if (!Model.Any())
  {
    <div class="empty-state">
      <div class="empty-ico"><i class="fas fa-book-open"></i></div>
      <h3 class="empty-title">No Courses Found</h3>
      <p class="empty-text">Add your first course to get started.</p>
      <a asp-action="Create" class="btn btn-primary"><i class="fas fa-plus me-1"></i>Add Course</a>
    </div>
  }
  else
  {
    <div class="table-wrap">
      <table id="coursesTable" class="tbl">
        <thead>
          <tr>
            <th>Course</th>
            <th>Code</th>
            <th>Department</th>
            <th>Credits</th>
            <th>Duration</th>
            <th>Students</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          @foreach (var c in Model)
          {
            <tr>
              <td>
                <div class="tbl-name">@c.Name</div>
                @if (!string.IsNullOrEmpty(c.Description))
                {
                  <div class="tbl-sub">@(c.Description.Length > 60 ? c.Description.Substring(0,60)+"…" : c.Description)</div>
                }
              </td>
              <td><span class="badge badge-primary">@c.Code</span></td>
              <td>@(c.Department?.Name ?? "—")</td>
              <td><span class="badge badge-info">@c.Credits Credit Hrs</span></td>
              <td>@c.Duration months</td>
              <td><span class="badge badge-success">@c.Students.Count</span></td>
              <td>
                <div class="tbl-actions">
                  <a asp-action="Details" asp-route-id="@c.Id" class="btn btn-info btn-sm"><i class="fas fa-eye"></i></a>
                  <a asp-action="Edit" asp-route-id="@c.Id" class="btn btn-warning btn-sm"><i class="fas fa-pen"></i></a>
                  @if (User.IsInRole("Admin"))
                  {
                    <form asp-action="Delete" asp-route-id="@c.Id" method="post" data-no-loading id="del-c-@c.Id">
                      @Html.AntiForgeryToken()
                      <button type="button" class="btn btn-danger btn-sm"
                              onclick="confirmDelete(document.getElementById('del-c-@c.Id'),'@Html.Raw(c.Name.Replace("'","\\'"))')">
                        <i class="fas fa-trash"></i>
                      </button>
                    </form>
                  }
                </div>
              </td>
            </tr>
          }
        </tbody>
      </table>
    </div>
  }
</div>
@section Scripts {
<script>$(document).ready(function(){initDataTable('coursesTable');});</script>
}
