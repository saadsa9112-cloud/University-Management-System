@model NedAcademy.Models.CourseModel
@{
  ViewData["Title"]      = "Add Course";
  ViewData["Breadcrumb"] = "Courses";
}

<div class="page-header">
  <div>
    <h1 class="page-title">Add New Course</h1>
    <p class="page-subtitle">Create a new academic course or program</p>
  </div>
  <a asp-action="Index" class="btn btn-secondary"><i class="fas fa-arrow-left me-1"></i>Back</a>
</div>

<div class="row justify-content-center">
  <div class="col-lg-7">
    <div class="card">
      <div class="card-head"><div class="card-head-title">Course Information</div></div>
      <div class="card-body">
        <form asp-action="Create" method="post">
          <div class="form-row">
            <div class="form-group">
              <label asp-for="Name" class="form-label">Course Name <span class="req">*</span></label>
              <input asp-for="Name" class="form-control" placeholder="e.g. Bachelor of Science in Computer Science" />
              <span asp-validation-for="Name" class="invalid-feedback"></span>
            </div>
            <div class="form-group">
              <label asp-for="Code" class="form-label">Course Code <span class="req">*</span></label>
              <input asp-for="Code" class="form-control" placeholder="e.g. BSCS" />
              <span asp-validation-for="Code" class="invalid-feedback"></span>
            </div>
          </div>
          <div class="form-row">
            <div class="form-group">
              <label asp-for="DepartmentId" class="form-label">Department <span class="req">*</span></label>
              <select asp-for="DepartmentId" class="form-select"
                      asp-items="@(new SelectList(ViewBag.Departments,"Id","Name"))">
                <option value="">— Select Department —</option>
              </select>
              <span asp-validation-for="DepartmentId" class="invalid-feedback"></span>
            </div>
            <div class="form-group">
              <label asp-for="Credits" class="form-label">Credit Hours</label>
              <input asp-for="Credits" class="form-control" type="number" min="1" max="6" />
              <span asp-validation-for="Credits" class="invalid-feedback"></span>
            </div>
          </div>
          <div class="form-group">
            <label asp-for="Duration" class="form-label">Duration (Months)</label>
            <input asp-for="Duration" class="form-control" type="number" min="1" max="120" />
          </div>
          <div class="form-group">
            <label asp-for="Description" class="form-label">Description</label>
            <textarea asp-for="Description" class="form-control" rows="3" placeholder="Brief description of the course"></textarea>
          </div>
          <hr class="my-3" />
          <div class="d-flex gap-2">
            <button type="submit" class="btn btn-primary"><i class="fas fa-save me-1"></i>Save Course</button>
            <a asp-action="Index" class="btn btn-secondary">Cancel</a>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>

@section Scripts { @{await Html.RenderPartialAsync("_ValidationScriptsPartial");} }
