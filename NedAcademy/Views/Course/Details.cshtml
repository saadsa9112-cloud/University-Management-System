@model NedAcademy.Models.CourseModel
@{
  ViewData["Title"]      = Model.Name + " – Details";
  ViewData["Breadcrumb"] = "Courses";
}

<div class="page-header">
  <div><h1 class="page-title">Course Details</h1></div>
  <div class="page-actions">
    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning"><i class="fas fa-pen me-1"></i>Edit</a>
    <a asp-action="Index" class="btn btn-secondary"><i class="fas fa-arrow-left me-1"></i>Back</a>
  </div>
</div>

<div class="profile-banner" style="background:linear-gradient(135deg,var(--accent),var(--info))">
  <div style="width:82px;height:82px;border-radius:50%;background:rgba(255,255,255,.18);display:flex;align-items:center;justify-content:center;font-size:2rem;color:#fff;border:3px solid rgba(255,255,255,.35)">
    <i class="fas fa-book-open"></i>
  </div>
  <div>
    <div class="profile-nm">@Model.Name</div>
    <div class="profile-role">
      <span class="badge" style="background:rgba(255,255,255,.25);color:#fff">Code: @Model.Code</span>
      <span class="badge ms-2" style="background:rgba(255,255,255,.25);color:#fff">@Model.Credits Credit Hrs</span>
    </div>
    <div style="font-size:.82rem;opacity:.8;margin-top:8px">
      <i class="fas fa-building-columns me-1"></i>@(Model.Department?.Name ?? "—")
    </div>
  </div>
</div>

<div class="card">
  <div class="card-head">
    <div class="card-head-title">Course Information</div>
    <span class="badge badge-success">@Model.Students.Count Students Enrolled</span>
  </div>
  <div class="card-body">
    <div class="detail-grid">
      <div class="detail-item"><div class="detail-lbl">Course Name</div><div class="detail-val">@Model.Name</div></div>
      <div class="detail-item"><div class="detail-lbl">Course Code</div><div class="detail-val">@Model.Code</div></div>
      <div class="detail-item"><div class="detail-lbl">Department</div><div class="detail-val">@(Model.Department?.Name ?? "—")</div></div>
      <div class="detail-item"><div class="detail-lbl">Credit Hours</div><div class="detail-val">@Model.Credits</div></div>
      <div class="detail-item"><div class="detail-lbl">Duration</div><div class="detail-val">@Model.Duration months</div></div>
      <div class="detail-item"><div class="detail-lbl">Students Enrolled</div><div class="detail-val">@Model.Students.Count</div></div>
      <div class="detail-item" style="grid-column:1/-1"><div class="detail-lbl">Description</div><div class="detail-val">@(Model.Description ?? "—")</div></div>
    </div>
  </div>
  <div class="card-foot">
    <div class="d-flex gap-2">
      <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning btn-sm"><i class="fas fa-pen me-1"></i>Edit</a>
      <form asp-action="Delete" asp-route-id="@Model.Id" method="post" data-no-loading id="crsDelForm">
        @Html.AntiForgeryToken()
        <button type="button" class="btn btn-danger btn-sm"
                onclick="confirmDelete(document.getElementById('crsDelForm'),'@Html.Raw(Model.Name.Replace("'","\\'"))')">
          <i class="fas fa-trash me-1"></i>Delete
        </button>
      </form>
    </div>
  </div>
</div>
