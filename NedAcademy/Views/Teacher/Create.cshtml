@model NedAcademy.Models.TeacherModel
@{
  ViewData["Title"]      = "Add Teacher";
  ViewData["Breadcrumb"] = "Teachers";
}

<div class="page-header">
  <div>
    <h1 class="page-title">Add New Teacher</h1>
    <p class="page-subtitle">Fill in the faculty member details below</p>
  </div>
  <a asp-action="Index" class="btn btn-secondary"><i class="fas fa-arrow-left me-1"></i>Back</a>
</div>

@if (!(ViewBag.Departments is IEnumerable<dynamic> depts && depts.Any()))
{
  <div class="alert alert-warning mb-3">
    <i class="fas fa-triangle-exclamation me-2"></i><strong>Notice:</strong> No departments are available yet. Please <a asp-controller="Department" asp-action="Create" class="alert-link">create a department</a> first.
  </div>
}

<form asp-action="Create" method="post" enctype="multipart/form-data">
  <div class="row g-4">
    <div class="col-lg-4">
      <div class="card">
        <div class="card-head"><div class="card-head-title">Photo</div></div>
        <div class="card-body text-center">
          <div id="imgPlaceholder" class="d-flex flex-column align-items-center justify-content-center"
               style="height:150px;border:2px dashed var(--border);border-radius:var(--r-md);background:var(--body-bg);cursor:pointer"
               onclick="document.getElementById('imageFile').click()">
            <i class="fas fa-camera" style="font-size:2rem;color:var(--text-muted)"></i>
            <span style="font-size:.78rem;color:var(--text-muted);margin-top:8px">Click to upload photo</span>
          </div>
          <img id="imgPreview" src="" alt="Preview"
               style="display:none;width:150px;height:150px;object-fit:cover;border-radius:var(--r-md);border:3px solid var(--primary-light);cursor:pointer"
               onclick="document.getElementById('imageFile').click()" />
          <input type="file" id="imageFile" name="imageFile" accept="image/*" class="d-none"
                 onchange="previewImage(this,'imgPreview','imgPlaceholder')" />
          <p class="text-muted mt-2" style="font-size:.72rem">JPG, PNG or GIF</p>
        </div>
      </div>
    </div>

    <div class="col-lg-8">
      <div class="card">
        <div class="card-head"><div class="card-head-title">Teacher Information</div></div>
        <div class="card-body">
          <div class="form-row">
            <div class="form-group">
              <label asp-for="Name" class="form-label">Full Name <span class="req">*</span></label>
              <input asp-for="Name" class="form-control" placeholder="e.g. Sir Tasbeel Ahmad" />
              <span asp-validation-for="Name" class="invalid-feedback"></span>
            </div>
            <div class="form-group">
              <label asp-for="Email" class="form-label">Email <span class="req">*</span></label>
              <input asp-for="Email" class="form-control" placeholder="teacher@nedacademy.edu" />
              <span asp-validation-for="Email" class="invalid-feedback"></span>
            </div>
          </div>
          <div class="form-row">
            <div class="form-group">
              <label asp-for="Phone" class="form-label">Phone</label>
              <input asp-for="Phone" class="form-control" placeholder="03XX-XXXXXXX" />
            </div>
            <div class="form-group">
              <label asp-for="Gender" class="form-label">Gender <span class="req">*</span></label>
              <select asp-for="Gender" class="form-select">
                <option value="Male">Male</option>
                <option value="Female">Female</option>
                <option value="Other">Other</option>
              </select>
            </div>
          </div>
          <div class="form-row">
            <div class="form-group">
              <label asp-for="Qualification" class="form-label">Qualification</label>
              <input asp-for="Qualification" class="form-control" placeholder="e.g. PhD Computer Science" />
            </div>
            <div class="form-group">
              <label asp-for="DepartmentId" class="form-label">Department <span class="req">*</span></label>
              <select asp-for="DepartmentId" class="form-select"
                      asp-items="@(new SelectList(ViewBag.Departments,"Id","Name"))">
                <option value="">— Select Department —</option>
              </select>
              <span asp-validation-for="DepartmentId" class="invalid-feedback"></span>
            </div>
          </div>
          <div class="form-row">
            <div class="form-group">
              <label asp-for="JoiningDate" class="form-label">Joining Date</label>
              <input asp-for="JoiningDate" type="date" class="form-control" />
            </div>
            <div class="form-group">
              <label asp-for="Salary" class="form-label">Salary (PKR) <span class="req">*</span></label>
              <input asp-for="Salary" class="form-control" type="number" min="0" placeholder="e.g. 75000" />
              <span asp-validation-for="Salary" class="invalid-feedback"></span>
            </div>
          </div>
          <div class="form-group">
            <label asp-for="Address" class="form-label">Address</label>
            <textarea asp-for="Address" class="form-control" rows="2" placeholder="Full address"></textarea>
          </div>
          <hr class="my-3" />
          <div class="d-flex gap-2">
            <button type="submit" class="btn btn-primary"><i class="fas fa-save me-1"></i>Save Teacher</button>
            <a asp-action="Index" class="btn btn-secondary">Cancel</a>
          </div>
        </div>
      </div>
    </div>
  </div>
</form>

@section Scripts {
  @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
