@model NedAcademy.Models.TeacherModel
@{
  ViewData["Title"]      = Model.Name + " – Details";
  ViewData["Breadcrumb"] = "Teachers";
}

<div class="page-header">
  <div><h1 class="page-title">Teacher Profile</h1></div>
  <div class="page-actions">
    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning"><i class="fas fa-pen me-1"></i>Edit</a>
    <a asp-action="Index" class="btn btn-secondary"><i class="fas fa-arrow-left me-1"></i>Back</a>
  </div>
</div>

<div class="profile-banner" style="background:linear-gradient(135deg,var(--success),#059669)">
  @if (!string.IsNullOrEmpty(Model.ImageUrl))
  {
    <img src="/@Model.ImageUrl" alt="@Model.Name" class="profile-img" />
  }
  else
  {
    <div style="width:82px;height:82px;border-radius:50%;background:rgba(255,255,255,.18);display:flex;align-items:center;justify-content:center;font-size:2rem;font-weight:800;color:#fff;border:3px solid rgba(255,255,255,.35)">
      @Model.Name[0]
    </div>
  }
  <div>
    <div class="profile-nm">@Model.Name</div>
    <div class="profile-role">
      <span class="badge @(Model.Gender=="Female"?"badge-female":"badge-male") me-2">@Model.Gender</span>
      @if (!string.IsNullOrEmpty(Model.Qualification))
      { <span class="badge" style="background:rgba(255,255,255,.2);color:#fff">@Model.Qualification</span> }
    </div>
    <div style="font-size:.82rem;opacity:.8;margin-top:8px">
      <i class="fas fa-envelope me-1"></i>@Model.Email
      @if (!string.IsNullOrEmpty(Model.Phone))
      { <span class="ms-3"><i class="fas fa-phone me-1"></i>@Model.Phone</span> }
    </div>
  </div>
</div>

<div class="card">
  <div class="card-head"><div class="card-head-title">Teacher Details</div></div>
  <div class="card-body">
    <div class="detail-grid">
      <div class="detail-item"><div class="detail-lbl">Full Name</div><div class="detail-val">@Model.Name</div></div>
      <div class="detail-item"><div class="detail-lbl">Email</div><div class="detail-val">@Model.Email</div></div>
      <div class="detail-item"><div class="detail-lbl">Phone</div><div class="detail-val">@(Model.Phone ?? "—")</div></div>
      <div class="detail-item"><div class="detail-lbl">Gender</div><div class="detail-val">@Model.Gender</div></div>
      <div class="detail-item"><div class="detail-lbl">Qualification</div><div class="detail-val">@(Model.Qualification ?? "—")</div></div>
      <div class="detail-item"><div class="detail-lbl">Department</div><div class="detail-val">@(Model.Department?.Name ?? "—")</div></div>
      <div class="detail-item"><div class="detail-lbl">Joining Date</div><div class="detail-val">@Model.JoiningDate.ToString("MMMM dd, yyyy")</div></div>
      <div class="detail-item"><div class="detail-lbl">Salary</div><div class="detail-val">PKR @Model.Salary.ToString("N0")</div></div>
      <div class="detail-item" style="grid-column:1/-1"><div class="detail-lbl">Address</div><div class="detail-val">@(Model.Address ?? "—")</div></div>
    </div>
  </div>
  <div class="card-foot">
    <div class="d-flex gap-2">
      <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning btn-sm"><i class="fas fa-pen me-1"></i>Edit</a>
      <form asp-action="Delete" asp-route-id="@Model.Id" method="post" data-no-loading id="tDelForm">
        @Html.AntiForgeryToken()
        <button type="button" class="btn btn-danger btn-sm"
                onclick="confirmDelete(document.getElementById('tDelForm'),'@Html.Raw(Model.Name.Replace("'","\\'"))')">
          <i class="fas fa-trash me-1"></i>Delete
        </button>
      </form>
    </div>
  </div>
</div>
