@model IEnumerable<NedAcademy.Models.NoticeModel>
@{
  ViewData["Title"]      = "Notice Board";
  ViewData["Breadcrumb"] = "Notices";
}

<div class="page-header">
  <div>
    <h1 class="page-title"><i class="fas fa-bell me-2" style="color:var(--primary)"></i>Notice Board</h1>
    <p class="page-subtitle">University announcements and communications</p>
  </div>
  <a asp-action="Create" class="btn btn-primary"><i class="fas fa-plus"></i> Post Notice</a>
</div>

@if (!Model.Any())
{
  <div class="card">
    <div class="empty-state">
      <div class="empty-ico"><i class="fas fa-bell"></i></div>
      <h3 class="empty-title">No Notices Published</h3>
      <p class="empty-text">Post your first university announcement.</p>
      <a asp-action="Create" class="btn btn-primary"><i class="fas fa-plus me-1"></i>Post Notice</a>
    </div>
  </div>
}
else
{
  <div class="row g-4">
    @foreach (var n in Model)
    {
      <div class="col-lg-6">
        <div class="card h-100" style="border-left:4px solid @(n.IsActive ? "var(--primary)" : "var(--border)")">
          <div class="card-body" style="padding:22px">
            <div class="d-flex justify-content-between align-items-start mb-3">
              <div>
                <span class="badge @(n.IsActive ? "badge-active" : "badge-inactive") mb-2">
                  <i class="fas fa-circle me-1" style="font-size:.45rem"></i>@(n.IsActive ? "Active" : "Archived")
                </span>
                <h3 style="font-size:1rem;font-weight:700;color:var(--text-main)">@n.Title</h3>
              </div>
            </div>
            <p style="font-size:.87rem;color:var(--text-sub);line-height:1.65;margin-bottom:16px">
              @(n.Content.Length > 200 ? n.Content.Substring(0,200) + "…" : n.Content)
            </p>
            <div style="font-size:.75rem;color:var(--text-muted)">
              <i class="fas fa-calendar-alt me-1"></i>@n.PublishedDate.ToString("MMMM dd, yyyy")
            </div>
          </div>
          <div class="card-foot">
            <div class="d-flex gap-2">
              <a asp-action="Details" asp-route-id="@n.Id" class="btn btn-info btn-sm"><i class="fas fa-eye me-1"></i>View</a>
              <a asp-action="Edit" asp-route-id="@n.Id" class="btn btn-warning btn-sm"><i class="fas fa-pen me-1"></i>Edit</a>
              <form asp-action="Delete" asp-route-id="@n.Id" method="post" data-no-loading id="del-n-@n.Id">
                @Html.AntiForgeryToken()
                <button type="button" class="btn btn-danger btn-sm"
                        onclick="confirmDelete(document.getElementById('del-n-@n.Id'),'this notice')">
                  <i class="fas fa-trash"></i>
                </button>
              </form>
            </div>
          </div>
        </div>
      </div>
    }
  </div>
}
