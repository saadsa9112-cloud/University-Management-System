@model NedAcademy.Models.NoticeModel
@{
  ViewData["Title"]      = "Notice Details";
  ViewData["Breadcrumb"] = "Notices";
}

<div class="page-header">
  <div><h1 class="page-title">Notice Details</h1></div>
  <div class="page-actions">
    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning"><i class="fas fa-pen me-1"></i>Edit</a>
    <a asp-action="Index" class="btn btn-secondary"><i class="fas fa-arrow-left me-1"></i>Back</a>
  </div>
</div>

<div class="row justify-content-center">
  <div class="col-lg-7">
    <div class="card" style="border-left:5px solid @(Model.IsActive ? "var(--primary)" : "var(--border)")">
      <div class="card-body" style="padding:28px">
        <div class="d-flex justify-content-between align-items-start mb-3">
          <span class="badge @(Model.IsActive ? "badge-active" : "badge-inactive") mb-2">
            <i class="fas fa-circle me-1" style="font-size:.45rem"></i>@(Model.IsActive ? "Active" : "Archived")
          </span>
          <span style="font-size:.78rem;color:var(--text-muted)">
            <i class="fas fa-calendar me-1"></i>@Model.PublishedDate.ToString("MMMM dd, yyyy")
          </span>
        </div>
        <h2 style="font-size:1.3rem;font-weight:800;color:var(--text-main);margin-bottom:18px">@Model.Title</h2>
        <div style="font-size:.9rem;color:var(--text-sub);line-height:1.75;white-space:pre-wrap">@Model.Content</div>
      </div>
      <div class="card-foot">
        <div class="d-flex gap-2">
          <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning btn-sm"><i class="fas fa-pen me-1"></i>Edit</a>
          <form asp-action="Delete" asp-route-id="@Model.Id" method="post" data-no-loading id="ntcDelForm">
            @Html.AntiForgeryToken()
            <button type="button" class="btn btn-danger btn-sm"
                    onclick="confirmDelete(document.getElementById('ntcDelForm'),'this notice')">
              <i class="fas fa-trash me-1"></i>Delete
            </button>
          </form>
        </div>
      </div>
    </div>
  </div>
</div>
