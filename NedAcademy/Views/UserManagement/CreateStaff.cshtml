@model NedAcademy.Models.ViewModels.CreateUserViewModel
@{
    ViewData["Title"]      = "Add User";
    ViewData["Breadcrumb"] = "User Management";
}

<div class="page-header">
    <div>
        <h1 class="page-title">Add New User</h1>
        <p class="page-subtitle">Create a new system account and assign a role</p>
    </div>
    <a asp-action="Index" class="btn btn-secondary"><i class="fas fa-arrow-left me-1"></i>Back</a>
</div>

<div class="row justify-content-center">
    <div class="col-lg-6">
        <div class="card">
            <div class="card-head">
                <div class="card-head-title"><i class="fas fa-user-plus me-2"></i>Account Details</div>
            </div>
            <div class="card-body">
                <form asp-action="CreateStaff" method="post">

                    @if (!ViewData.ModelState.IsValid && ViewData.ModelState.ErrorCount > 0)
                    {
                        <div class="alert alert-danger">
                            <i class="fas fa-circle-exclamation me-2"></i>
                            <div asp-validation-summary="All" style="margin:0"></div>
                        </div>
                    }

                    <!-- Role Selector -->
                    <div class="role-selector mb-4">
                        <label class="form-label fw-semibold">Assign Role</label>
                        <div class="d-flex gap-3">
                            <div class="flex-fill">
                                <input type="radio" name="Role" id="roleAdmin" value="Admin" class="role-radio"
                                       @(Model?.Role == "Admin" ? "checked" : "") />
                                <label for="roleAdmin" class="role-tab w-100">
                                    <i class="fas fa-shield-halved me-1"></i>Admin
                                    <span class="role-tab-hint">Full access</span>
                                </label>
                            </div>
                            <div class="flex-fill">
                                <input type="radio" name="Role" id="roleFaculty" value="Faculty" class="role-radio"
                                       @(Model == null || Model.Role == "Faculty" ? "checked" : "") />
                                <label for="roleFaculty" class="role-tab w-100">
                                    <i class="fas fa-chalkboard-user me-1"></i>Faculty
                                    <span class="role-tab-hint">Teaching staff</span>
                                </label>
                            </div>
                        </div>
                        <span asp-validation-for="Role" class="invalid-feedback"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="Email" class="form-label">Email Address <span class="req">*</span></label>
                        <div class="search-wrap">
                            <i class="fas fa-envelope search-ico"></i>
                            <input asp-for="Email" class="form-control search-input" placeholder="user@nedacademy.edu" />
                        </div>
                        <span asp-validation-for="Email" class="invalid-feedback"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="Password" class="form-label">Password <span class="req">*</span></label>
                        <div class="search-wrap">
                            <i class="fas fa-lock search-ico"></i>
                            <input asp-for="Password" type="password" class="form-control search-input" placeholder="Min. 6 characters" />
                        </div>
                        <span asp-validation-for="Password" class="invalid-feedback"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="ConfirmPassword" class="form-label">Confirm Password <span class="req">*</span></label>
                        <div class="search-wrap">
                            <i class="fas fa-lock search-ico"></i>
                            <input asp-for="ConfirmPassword" type="password" class="form-control search-input" placeholder="Repeat password" />
                        </div>
                        <span asp-validation-for="ConfirmPassword" class="invalid-feedback"></span>
                    </div>

                    <div class="alert alert-info">
                        <i class="fas fa-info-circle me-2"></i>
                        <strong>Faculty</strong> can add/edit Students and Notices but <strong>cannot delete</strong> Departments, Courses, or Teachers.
                        <strong>Admin</strong> has full access to everything.
                    </div>

                    <hr class="my-3" />
                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary">
                            <i class="fas fa-user-plus me-1"></i>Create User
                        </button>
                        <a asp-action="Index" class="btn btn-secondary">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
