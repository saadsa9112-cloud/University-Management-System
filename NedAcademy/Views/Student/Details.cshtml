@model NedAcademy.Models.StudentModel
@{
  ViewData["Title"]      = Model.Name + " – Details";
  ViewData["Breadcrumb"] = "Students";
}

<div class="page-header">
  <div>
    <h1 class="page-title">Student Profile</h1>
    <p class="page-subtitle">Full details for @Model.Name</p>
  </div>
  <div class="page-actions">
    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning"><i class="fas fa-pen me-1"></i>Edit</a>
    <a asp-action="Index" class="btn btn-secondary"><i class="fas fa-arrow-left me-1"></i>Back</a>
  </div>
</div>

<!-- Profile banner -->
<div class="profile-banner">
  @if (!string.IsNullOrEmpty(Model.ImageUrl))
  {
    <img src="/@Model.ImageUrl" alt="@Model.Name" class="profile-img" />
  }
  else
  {
    <div class="profile-av-ph av-c@((Model.Id%5)+1)" style="width:82px;height:82px;font-size:2rem;font-weight:800;border-radius:50%;border:3px solid rgba(255,255,255,.35);display:flex;align-items:center;justify-content:center">
      @Model.Name[0]
    </div>
  }
  <div>
    <div class="profile-nm">@Model.Name</div>
    <div class="profile-role">
      <span class="badge @(Model.Gender=="Female"?"badge-female":"badge-male") me-2">@Model.Gender</span>
      <span class="badge badge-primary">@Model.RollNumber</span>
    </div>
    <div style="font-size:.82rem;opacity:.8;margin-top:8px">
      <i class="fas fa-envelope me-1"></i>@Model.Email
      @if (!string.IsNullOrEmpty(Model.Phone))
      { <span class="ms-3"><i class="fas fa-phone me-1"></i>@Model.Phone</span> }
    </div>
  </div>
</div>

<!-- Detail cards -->
<div class="card">
  <div class="card-head"><div class="card-head-title">Personal Information</div></div>
  <div class="card-body">
    <div class="detail-grid">
      <div class="detail-item">
        <div class="detail-lbl">Full Name</div>
        <div class="detail-val">@Model.Name</div>
      </div>
      <div class="detail-item">
        <div class="detail-lbl">Roll Number</div>
        <div class="detail-val">@Model.RollNumber</div>
      </div>
      <div class="detail-item">
        <div class="detail-lbl">Email</div>
        <div class="detail-val">@Model.Email</div>
      </div>
      <div class="detail-item">
        <div class="detail-lbl">Phone</div>
        <div class="detail-val">@(Model.Phone ?? "—")</div>
      </div>
      <div class="detail-item">
        <div class="detail-lbl">Date of Birth</div>
        <div class="detail-val">@Model.DateOfBirth.ToString("MMMM dd, yyyy")</div>
      </div>
      <div class="detail-item">
        <div class="detail-lbl">Gender</div>
        <div class="detail-val">@Model.Gender</div>
      </div>
      <div class="detail-item" style="grid-column:1/-1">
        <div class="detail-lbl">Address</div>
        <div class="detail-val">@(Model.Address ?? "—")</div>
      </div>
    </div>
  </div>
</div>

<div class="card mt-4">
  <div class="card-head"><div class="card-head-title">Academic Information</div></div>
  <div class="card-body">
    <div class="detail-grid">
      <div class="detail-item">
        <div class="detail-lbl">Department</div>
        <div class="detail-val">@(Model.Department?.Name ?? "—")</div>
      </div>
      <div class="detail-item">
        <div class="detail-lbl">Course</div>
        <div class="detail-val">@(Model.Course?.Name ?? "—")</div>
      </div>
      <div class="detail-item">
        <div class="detail-lbl">Education Level</div>
        <div class="detail-val">@(Model.Education ?? "—")</div>
      </div>
      <div class="detail-item">
        <div class="detail-lbl">Semester Fees</div>
        <div class="detail-val">PKR @Model.Fees.ToString("N0")</div>
      </div>
      <div class="detail-item">
        <div class="detail-lbl">Enrollment Date</div>
        <div class="detail-val">@Model.EnrollmentDate.ToString("MMMM dd, yyyy")</div>
      </div>
    </div>
  </div>
  <div class="card-foot">
    <div class="d-flex gap-2">
      <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning btn-sm">
        <i class="fas fa-pen me-1"></i>Edit Student
      </a>
      <form asp-action="Delete" asp-route-id="@Model.Id" method="post" data-no-loading id="detailDelForm">
        @Html.AntiForgeryToken()
        <button type="button" class="btn btn-danger btn-sm"
                onclick="confirmDelete(document.getElementById('detailDelForm'),'@Html.Raw(Model.Name.Replace("'","\\'"))')">
          <i class="fas fa-trash me-1"></i>Delete
        </button>
      </form>
    </div>
  </div>
</div>
