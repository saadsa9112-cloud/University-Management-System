@model NedAcademy.Models.StudentModel
@{
  ViewData["Title"]      = "Delete Student";
  ViewData["Breadcrumb"] = "Students";
}

<div class="page-header">
  <div>
    <h1 class="page-title">Delete Student</h1>
    <p class="page-subtitle">Please confirm the deletion below</p>
  </div>
  <a asp-action="Index" class="btn btn-secondary"><i class="fas fa-arrow-left me-1"></i>Back</a>
</div>

<div class="row justify-content-center">
  <div class="col-lg-6">
    <div class="card">
      <div class="card-head" style="background:var(--danger-bg);border-bottom-color:#fca5a5">
        <div>
          <div class="card-head-title" style="color:#991b1b">
            <i class="fas fa-triangle-exclamation me-2"></i>Confirm Deletion
          </div>
        </div>
      </div>
      <div class="card-body text-center py-4">
        @if (!string.IsNullOrEmpty(Model.ImageUrl))
        {
          <img src="/@Model.ImageUrl" alt="@Model.Name"
               style="width:80px;height:80px;border-radius:50%;object-fit:cover;margin-bottom:16px" />
        }
        else
        {
          <div class="d-flex align-items-center justify-content-center mx-auto mb-3"
               style="width:80px;height:80px;border-radius:50%;font-size:2rem;font-weight:800;color:#fff"
               class="av-c@((Model.Id%5)+1)">
            @Model.Name[0]
          </div>
        }
        <h5 style="font-weight:700;color:var(--text-main)">@Model.Name</h5>
        <p style="font-size:.85rem;color:var(--text-sub)">@Model.Email</p>
        <span class="badge badge-primary me-1">@Model.RollNumber</span>
        <span class="badge badge-secondary">@(Model.Department?.Name ?? "N/A")</span>

        <div class="alert alert-danger mt-4 text-start">
          <i class="fas fa-exclamation-triangle me-2"></i>
          <strong>This action is irreversible.</strong> The student record and associated photo will be permanently deleted.
        </div>

        <form asp-action="Delete" method="post" class="mt-3">
          @Html.AntiForgeryToken()
          <input type="hidden" asp-for="Id" />
          <div class="d-flex gap-2 justify-content-center">
            <button type="submit" class="btn btn-danger">
              <i class="fas fa-trash me-1"></i>Yes, Delete Permanently
            </button>
            <a asp-action="Index" class="btn btn-secondary">Cancel</a>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>