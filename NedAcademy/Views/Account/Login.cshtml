@model NedAcademy.Models.ViewModels.LoginViewModel
@{
    ViewData["Title"] = "Login – NED Academy";
    Layout = "_LoginLayout";
}

<div class="auth-split">

  <!-- Left branding panel -->
  <div class="auth-panel-left">
    <div class="auth-brand">
      <div class="auth-logo">
        <i class="fas fa-graduation-cap"></i>
      </div>
      <h1 class="auth-brand-name">NED Academy</h1>
      <p class="auth-brand-tagline">University Management System</p>
    </div>
    <div class="auth-features">
      <div class="auth-feat"><i class="fas fa-check-circle"></i> Students &amp; Faculty management</div>
      <div class="auth-feat"><i class="fas fa-check-circle"></i> Department &amp; Course tracking</div>
      <div class="auth-feat"><i class="fas fa-check-circle"></i> Notice board &amp; announcements</div>
      <div class="auth-feat"><i class="fas fa-check-circle"></i> Role-based secure access</div>
    </div>
    <div class="auth-panel-footer">© @DateTime.Now.Year NED Academy. All rights reserved.</div>
  </div>

  <!-- Right form panel -->
  <div class="auth-panel-right">
    <div class="auth-form-wrap">

      <div class="auth-form-head">
        <h2 class="auth-form-title">Welcome Back</h2>
        <p class="auth-form-sub">Sign in to your account to continue</p>
      </div>

      @if (!ViewData.ModelState.IsValid)
      {
        <div class="alert alert-danger">
          <i class="fas fa-circle-exclamation me-2"></i>
          <div asp-validation-summary="All" style="margin:0;display:inline"></div>
        </div>
      }

      @if (TempData["Error"] != null)
      {
        <div class="alert alert-danger"><i class="fas fa-circle-exclamation me-2"></i>@TempData["Error"]</div>
      }

      <form asp-action="Login" method="post">
        @Html.AntiForgeryToken()

        <!-- Role Selector (tab-style) -->
        <div class="role-selector mb-3">
          <label class="form-label fw-semibold">Login As</label>
          <div class="role-tabs">
            <input type="radio" name="Role" id="roleAdmin" value="Admin"
                   class="role-radio" @(Model?.Role == "Admin" ? "checked" : "") />
            <label for="roleAdmin" class="role-tab">
              <i class="fas fa-shield-halved me-2"></i>Admin
            </label>

            <input type="radio" name="Role" id="roleFaculty" value="Faculty"
                   class="role-radio" @(Model == null || Model.Role == "Faculty" ? "checked" : "") />
            <label for="roleFaculty" class="role-tab">
              <i class="fas fa-chalkboard-user me-2"></i>Faculty
            </label>
          </div>
          <span asp-validation-for="Role" class="invalid-feedback"></span>
        </div>

        <div class="form-group">
          <label asp-for="Email" class="form-label fw-semibold">Email Address</label>
          <div class="auth-input-wrap">
            <i class="fas fa-envelope auth-input-ico"></i>
            <input asp-for="Email" class="form-control auth-input"
                   placeholder="your@email.com" autocomplete="email" />
          </div>
          <span asp-validation-for="Email" class="invalid-feedback"></span>
        </div>

        <div class="form-group">
          <label asp-for="Password" class="form-label fw-semibold">Password</label>
          <div class="auth-input-wrap">
            <i class="fas fa-lock auth-input-ico"></i>
            <input asp-for="Password" type="password" class="form-control auth-input"
                   placeholder="••••••••" autocomplete="current-password" id="pwdField" />
            <button type="button" class="auth-eye" onclick="togglePwd()" tabindex="-1">
              <i class="fas fa-eye" id="eyeIco"></i>
            </button>
          </div>
          <span asp-validation-for="Password" class="invalid-feedback"></span>
        </div>

        <div class="d-flex justify-content-between align-items-center mb-3">
          <div class="form-check">
            <input asp-for="RememberMe" class="form-check-input" id="rememberMe" />
            <label class="form-check-label" for="rememberMe" style="font-size:.85rem">Remember me</label>
          </div>
        </div>

        <button type="submit" class="btn btn-primary w-100" style="padding:13px;font-size:1rem;font-weight:700">
          <i class="fas fa-sign-in-alt me-2"></i>Sign In
        </button>
      </form>

      <div class="auth-divider"><span>Don't have an account?</span></div>

      <a asp-action="Register" class="btn w-100"
         style="padding:12px;border:2px solid var(--border);color:var(--text-main);font-weight:600;border-radius:var(--r-md);background:transparent;transition:var(--transition-s)"
         onmouseover="this.style.borderColor='var(--primary)';this.style.color='var(--primary)'"
         onmouseout="this.style.borderColor='var(--border)';this.style.color='var(--text-main)'">
        <i class="fas fa-user-plus me-2"></i>Create New Account
      </a>

    </div>
  </div>
</div>

@section Scripts {
  @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
  <script>
    function togglePwd() {
      const f = document.getElementById('pwdField');
      const i = document.getElementById('eyeIco');
      if (f.type === 'password') { f.type = 'text'; i.className = 'fas fa-eye-slash'; }
      else { f.type = 'password'; i.className = 'fas fa-eye'; }
    }
  </script>
}
