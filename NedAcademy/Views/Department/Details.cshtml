@model NedAcademy.Models.DepartmentModel
@{
  ViewData["Title"]      = Model.Name + " – Details";
  ViewData["Breadcrumb"] = "Departments";
}

<div class="page-header">
  <div><h1 class="page-title">Department Details</h1></div>
  <div class="page-actions">
    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning"><i class="fas fa-pen me-1"></i>Edit</a>
    <a asp-action="Index" class="btn btn-secondary"><i class="fas fa-arrow-left me-1"></i>Back</a>
  </div>
</div>

<div class="profile-banner" style="background:linear-gradient(135deg,var(--warning),#d97706)">
  <div style="width:82px;height:82px;border-radius:50%;background:rgba(255,255,255,.18);display:flex;align-items:center;justify-content:center;font-size:2rem;color:#fff;border:3px solid rgba(255,255,255,.35)">
    <i class="fas fa-building-columns"></i>
  </div>
  <div>
    <div class="profile-nm">@Model.Name</div>
    <div class="profile-role">
      <span class="badge" style="background:rgba(255,255,255,.25);color:#fff">Code: @Model.Code</span>
    </div>
    @if (!string.IsNullOrEmpty(Model.HeadOfDept))
    { <div style="font-size:.82rem;opacity:.8;margin-top:8px"><i class="fas fa-user-tie me-1"></i>@Model.HeadOfDept</div> }
  </div>
</div>

<div class="row g-4 mb-4">
  <div class="col-md-4">
    <div class="stat-card clr-indigo">
      <div class="stat-card-top"><div class="stat-icon"><i class="fas fa-user-graduate"></i></div></div>
      <div class="stat-val">@Model.Students.Count</div>
      <div class="stat-lbl">Total Students</div>
    </div>
  </div>
  <div class="col-md-4">
    <div class="stat-card clr-green">
      <div class="stat-card-top"><div class="stat-icon"><i class="fas fa-chalkboard-user"></i></div></div>
      <div class="stat-val">@Model.Teachers.Count</div>
      <div class="stat-lbl">Teachers</div>
    </div>
  </div>
  <div class="col-md-4">
    <div class="stat-card clr-cyan">
      <div class="stat-card-top"><div class="stat-icon"><i class="fas fa-book-open"></i></div></div>
      <div class="stat-val">@Model.Courses.Count</div>
      <div class="stat-lbl">Courses</div>
    </div>
  </div>
</div>

<div class="card">
  <div class="card-head"><div class="card-head-title">Department Information</div></div>
  <div class="card-body">
    <div class="detail-grid">
      <div class="detail-item"><div class="detail-lbl">Name</div><div class="detail-val">@Model.Name</div></div>
      <div class="detail-item"><div class="detail-lbl">Code</div><div class="detail-val">@Model.Code</div></div>
      <div class="detail-item"><div class="detail-lbl">Head of Department</div><div class="detail-val">@(Model.HeadOfDept ?? "—")</div></div>
      <div class="detail-item"><div class="detail-lbl">Established</div><div class="detail-val">@Model.CreatedAt.ToString("MMMM yyyy")</div></div>
      <div class="detail-item" style="grid-column:1/-1"><div class="detail-lbl">Description</div><div class="detail-val">@(Model.Description ?? "—")</div></div>
    </div>
  </div>
  <div class="card-foot">
    <div class="d-flex gap-2">
      <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning btn-sm"><i class="fas fa-pen me-1"></i>Edit</a>
      <form asp-action="Delete" asp-route-id="@Model.Id" method="post" data-no-loading id="deptDelForm">
        @Html.AntiForgeryToken()
        <button type="button" class="btn btn-danger btn-sm"
                onclick="confirmDelete(document.getElementById('deptDelForm'),'@Html.Raw(Model.Name.Replace("'","\\'"))')">
          <i class="fas fa-trash me-1"></i>Delete
        </button>
      </form>
    </div>
  </div>
</div>
