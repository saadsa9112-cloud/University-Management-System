@model IEnumerable<NedAcademy.Models.DepartmentModel>
@{
  ViewData["Title"]      = "Departments";
  ViewData["Breadcrumb"] = "Departments";
}

<div class="page-header">
  <div>
    <h1 class="page-title"><i class="fas fa-building-columns me-2" style="color:var(--warning)"></i>Departments</h1>
    <p class="page-subtitle">Manage academic departments and their allocations</p>
  </div>
  <a asp-action="Create" class="btn btn-primary"><i class="fas fa-plus"></i> Add Department</a>
</div>

@if (!Model.Any())
{
  <div class="card">
    <div class="empty-state">
      <div class="empty-ico"><i class="fas fa-building-columns"></i></div>
      <h3 class="empty-title">No Departments Found</h3>
      <p class="empty-text">Create your first department to get started.</p>
      <a asp-action="Create" class="btn btn-primary"><i class="fas fa-plus me-1"></i>Add Department</a>
    </div>
  </div>
}
else
{
  <div class="row g-4">
    @foreach (var d in Model)
    {
      <div class="col-lg-4 col-md-6">
        <div class="card h-100" style="transition:var(--transition-s)">
          <div class="card-body" style="padding:24px">
            <div class="d-flex align-items-center gap-3 mb-3">
              <div style="width:52px;height:52px;border-radius:var(--r);background:linear-gradient(135deg,var(--primary),var(--secondary));display:flex;align-items:center;justify-content:center;color:#fff;font-size:1.15rem;flex-shrink:0">
                <i class="fas fa-building-columns"></i>
              </div>
              <div>
                <div style="font-size:1rem;font-weight:800;color:var(--text-main)">@d.Name</div>
                <div style="font-size:.75rem;color:var(--text-muted)">Code: <strong>@d.Code</strong></div>
              </div>
            </div>
            @if (!string.IsNullOrEmpty(d.Description))
            {
              <p style="font-size:.82rem;color:var(--text-sub);margin-bottom:14px">
                @(d.Description.Length > 100 ? d.Description.Substring(0,100) + "…" : d.Description)
              </p>
            }
            @if (!string.IsNullOrEmpty(d.HeadOfDept))
            {
              <div style="font-size:.8rem;color:var(--text-sub);margin-bottom:14px">
                <i class="fas fa-user-tie me-2" style="color:var(--primary)"></i>@d.HeadOfDept
              </div>
            }

            <div class="d-flex gap-2 flex-wrap mb-3">
              <div class="d-flex align-items-center gap-1" style="font-size:.8rem">
                <span class="badge badge-primary"><i class="fas fa-user-graduate me-1"></i>@d.Students.Count Students</span>
              </div>
              <div class="d-flex align-items-center gap-1" style="font-size:.8rem">
                <span class="badge badge-success"><i class="fas fa-chalkboard-user me-1"></i>@d.Teachers.Count Teachers</span>
              </div>
              <div class="d-flex align-items-center gap-1" style="font-size:.8rem">
                <span class="badge badge-info"><i class="fas fa-book-open me-1"></i>@d.Courses.Count Courses</span>
              </div>
            </div>
          </div>
          <div class="card-foot">
            <div class="d-flex gap-2">
              <a asp-action="Details" asp-route-id="@d.Id" class="btn btn-info btn-sm"><i class="fas fa-eye me-1"></i>View</a>
              <a asp-action="Edit" asp-route-id="@d.Id" class="btn btn-warning btn-sm"><i class="fas fa-pen me-1"></i>Edit</a>
              @if (User.IsInRole("Admin"))
              {
                <form asp-action="Delete" asp-route-id="@d.Id" method="post" data-no-loading id="del-d-@d.Id">
                  @Html.AntiForgeryToken()
                  <button type="button" class="btn btn-danger btn-sm"
                          onclick="confirmDelete(document.getElementById('del-d-@d.Id'),'@Html.Raw(d.Name.Replace("'","\\'"))')">
                    <i class="fas fa-trash"></i>
                  </button>
                </form>
              }
            </div>
          </div>
        </div>
      </div>
    }
  </div>
}
