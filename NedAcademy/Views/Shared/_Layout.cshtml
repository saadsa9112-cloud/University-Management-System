<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content="NED Academy – University Management System" />
  <title>@ViewData["Title"] – NED Academy</title>

  <!-- Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">

  <!-- Font Awesome 6 -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />

  <!-- Bootstrap 5 -->
  <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

  <!-- DataTables + Bootstrap5 theme -->
  <link rel="stylesheet" href="https://cdn.datatables.net/1.13.7/css/dataTables.bootstrap5.min.css" />

  <!-- Toastr -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css" />

  <!-- Custom CSS -->
  <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="app-layout">

  <!-- Mobile sidebar overlay -->
  <div class="sidebar-overlay" id="sidebarOverlay"></div>

  <!-- Loading overlay -->
  <div class="loading-overlay" id="loadingOverlay">
    <div class="spinner"></div>
  </div>

  <!-- ══════════════════════════════════════════
       SIDEBAR
  ═══════════════════════════════════════════ -->
  <aside class="sidebar" id="sidebar">

    <!-- Logo -->
    <div class="sidebar-logo">
      <div class="logo-icon"><i class="fas fa-graduation-cap"></i></div>
      <div class="logo-text">
        <div class="logo-title">NED Academy</div>
        <div class="logo-sub">Management System</div>
      </div>
    </div>

    <!-- Navigation -->
    <nav class="sidebar-nav" id="sidebarNav">

      <div class="nav-section-label">Main</div>

      <div class="nav-item">
        <a asp-controller="Home" asp-action="Index" class="nav-link-item">
          <i class="fas fa-gauge-high nav-ico"></i>
          <span class="nav-label">Dashboard</span>
        </a>
      </div>

      <div class="nav-section-label">Academic</div>

      <div class="nav-item">
        <a asp-controller="Student" asp-action="Index" class="nav-link-item">
          <i class="fas fa-user-graduate nav-ico"></i>
          <span class="nav-label">Students</span>
        </a>
      </div>

      <div class="nav-item">
        <a asp-controller="Teacher" asp-action="Index" class="nav-link-item">
          <i class="fas fa-chalkboard-user nav-ico"></i>
          <span class="nav-label">Teachers</span>
        </a>
      </div>

      <div class="nav-item">
        <a asp-controller="Department" asp-action="Index" class="nav-link-item">
          <i class="fas fa-building-columns nav-ico"></i>
          <span class="nav-label">Departments</span>
        </a>
      </div>

      <div class="nav-item">
        <a asp-controller="Course" asp-action="Index" class="nav-link-item">
          <i class="fas fa-book-open nav-ico"></i>
          <span class="nav-label">Courses</span>
        </a>
      </div>

      <hr class="nav-divider" />
      <div class="nav-section-label">Communication</div>

      <div class="nav-item">
        <a asp-controller="Notice" asp-action="Index" class="nav-link-item">
          <i class="fas fa-bell nav-ico"></i>
          <span class="nav-label">Notices</span>
        </a>
      </div>

      <hr class="nav-divider" />
      <div class="nav-section-label">Account</div>

      @if (User.IsInRole("Admin"))
      {
        <div class="nav-item">
          <a asp-controller="UserManagement" asp-action="Index" class="nav-link-item">
            <i class="fas fa-users-cog nav-ico"></i>
            <span class="nav-label">User Management</span>
          </a>
        </div>
      }

      <div class="nav-item">
        <form asp-controller="Account" asp-action="Logout" method="post" data-no-loading style="width:100%">
          @Html.AntiForgeryToken()
          <button type="submit" class="nav-link-item" style="color:#f87171">
            <i class="fas fa-right-from-bracket nav-ico" style="color:#f87171"></i>
            <span class="nav-label">Logout</span>
          </button>
        </form>
      </div>

    </nav>

    <!-- Sidebar user footer -->
    @if (User.Identity?.IsAuthenticated == true)
    {
      <div class="sidebar-footer">
        <div class="sidebar-user">
          <div class="user-av">@(User.Identity.Name?.Substring(0,1).ToUpper() ?? "U")</div>
          <div class="user-info-wrap">
            <div class="user-nm">@(User.Identity.Name?.Split('@')[0] ?? "User")</div>
            <div class="user-rl">@(User.IsInRole("Admin") ? "Administrator" : "Faculty")</div>
          </div>
        </div>
      </div>
    }
  </aside>

  <!-- ══════════════════════════════════════════
       MAIN WRAPPER
  ═══════════════════════════════════════════ -->
  <div class="main-wrapper" id="mainWrapper">

    <!-- TOP NAVBAR -->
    <nav class="top-navbar">
      <button class="nav-toggle" id="navToggle" aria-label="Toggle sidebar">
        <i class="fas fa-bars"></i>
      </button>

      <div class="breadcrumb-wrap">
        <ol class="breadcrumb">
          <li class="breadcrumb-item">
            <a asp-controller="Home" asp-action="Index">
              <i class="fas fa-home me-1"></i>Home
            </a>
          </li>
          @if (ViewData["Breadcrumb"] != null)
          {
            <li class="breadcrumb-item active">@ViewData["Breadcrumb"]</li>
          }
        </ol>
      </div>

      <div class="nav-actions">
        <a asp-controller="Notice" asp-action="Create" class="nav-act-btn" title="New Notice">
          <i class="fas fa-plus"></i>
        </a>
        <a asp-controller="Notice" asp-action="Index" class="nav-act-btn" title="Notices">
          <i class="fas fa-bell"></i>
          <span class="nav-badge"></span>
        </a>
        <div class="nav-sep"></div>
        @if (User.Identity?.IsAuthenticated == true)
        {
          <div class="dropdown">
            <div class="nav-user" data-bs-toggle="dropdown" aria-expanded="false">
              <div class="nav-user-av">@(User.Identity.Name?.Substring(0,1).ToUpper() ?? "U")</div>
              <div class="d-none d-md-block">
                <div class="nav-user-nm">@(User.Identity.Name?.Split('@')[0] ?? "User")</div>
                <div class="nav-user-rl">@(User.IsInRole("Admin") ? "Administrator" : "Faculty")</div>
              </div>
              <i class="fas fa-chevron-down ms-2" style="font-size:.65rem;color:var(--text-muted)"></i>
            </div>
            <ul class="dropdown-menu dropdown-menu-end shadow">
              <li class="px-3 py-2 border-bottom">
                <div style="font-size:.78rem;font-weight:700;color:var(--text-main)">@User.Identity.Name</div>
                <div style="font-size:.7rem;color:var(--text-muted)">@(User.IsInRole("Admin") ? "Administrator" : "Faculty")</div>
              </li>
              <li>
                <form asp-controller="Account" asp-action="Logout" method="post" data-no-loading>
                  @Html.AntiForgeryToken()
                  <button type="submit" class="dropdown-item text-danger py-2">
                    <i class="fas fa-right-from-bracket me-2"></i>Logout
                  </button>
                </form>
              </li>
            </ul>
          </div>
        }
      </div>
    </nav>

    <!-- PAGE CONTENT -->
    <main class="page-content">
      @RenderBody()
    </main>

    <!-- FOOTER -->
    <footer class="app-footer">
      <div>&copy; @DateTime.Now.Year <strong>NED Academy</strong> &mdash; University Management System</div>
      <div class="footer-links">
        <a href="#">Privacy</a>
        <a href="#">Support</a>
        <a asp-controller="Notice" asp-action="Index">Notices</a>
      </div>
    </footer>
  </div><!-- /main-wrapper -->

  <!-- ══════ SCRIPTS ══════ -->
  <script src="~/lib/jquery/dist/jquery.min.js"></script>
  <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
  <script src="https://cdn.datatables.net/1.13.7/js/jquery.dataTables.min.js"></script>
  <script src="https://cdn.datatables.net/1.13.7/js/dataTables.bootstrap5.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
  <script src="~/js/site.js" asp-append-version="true"></script>

  @* TempData → Toastr Notifications *@
  @if (TempData["Success"] != null)
  {
    <script>document.addEventListener('DOMContentLoaded',()=>toastr.success('@Html.Raw(TempData["Success"]?.ToString()?.Replace("'","\\'")??"")'));</script>
  }
  @if (TempData["Error"] != null)
  {
    <script>document.addEventListener('DOMContentLoaded',()=>toastr.error('@Html.Raw(TempData["Error"]?.ToString()?.Replace("'","\\'")??"")'));</script>
  }
  @if (TempData["Warning"] != null)
  {
    <script>document.addEventListener('DOMContentLoaded',()=>toastr.warning('@Html.Raw(TempData["Warning"]?.ToString()?.Replace("'","\\'")??"")'));</script>
  }

  @await RenderSectionAsync("Modals", required: false)
  @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
