@model ErrorViewModel
@{
    ViewData["Title"] = Model.StatusCode.HasValue ? $"Error {Model.StatusCode}" : "Error";
}

<div class="d-flex flex-column align-items-center justify-content-center text-center py-5">
    <div style="width:84px;height:84px;border-radius:var(--r-lg);background:rgba(239,68,68,.1);display:flex;align-items:center;justify-content:center;margin-bottom:20px">
        <i class="fas fa-triangle-exclamation" style="font-size:2.4rem;color:var(--danger)"></i>
    </div>

    <h1 style="font-size:2.2rem;font-weight:800;color:var(--text-main);margin-bottom:8px">
        @(Model.StatusCode.HasValue ? $"Error {Model.StatusCode}" : "Something Went Wrong")
    </h1>

    <p style="font-size:1.05rem;color:var(--text-sub);max-width:520px;line-height:1.6;margin-bottom:24px">
        @(Model.Message ?? "An unexpected error occurred while processing your request.")
    </p>

    @if (Model.ShowRequestId)
    {
        <div style="font-size:.8rem;color:var(--text-muted);background:var(--body-bg);border:1px solid var(--border);border-radius:var(--r-sm);padding:6px 14px;margin-bottom:24px">
            <span class="fw-semibold">Request ID:</span> <code>@Model.RequestId</code>
        </div>
    }

    <div class="d-flex gap-3">
        @if (User.Identity?.IsAuthenticated == true)
        {
            <a asp-controller="Home" asp-action="Index" class="btn btn-primary" style="padding:10px 22px">
                <i class="fas fa-house me-2"></i>Back to Dashboard
            </a>
        }
        else
        {
            <a asp-controller="Account" asp-action="Login" class="btn btn-primary" style="padding:10px 22px">
                <i class="fas fa-arrow-left me-2"></i>Return to Login
            </a>
        }
        <button type="button" onclick="history.back()" class="btn btn-secondary" style="padding:10px 20px">
            <i class="fas fa-arrow-rotate-left me-2"></i>Go Back
        </button>
    </div>
</div>
